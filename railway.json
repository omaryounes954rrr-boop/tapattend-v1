{
  "build": {
    "builder": "render",
    "commands": {
      "installDependencies": "cd backend && pip install -r requirements.txt",
      "build": "cd backend && echo 'Build complete'"
    }
  },
  "deploy": {
    "startCommand": "cd backend && python -m uvicorn app.main:app --port $PORT",
    "healthCheckPath": "/api/health",
    "healthCheckTimeout": 10,
    "restartPolicy": {
      "maximumRetryAttempts": 10,
      "interval": 30
    }
  }
}